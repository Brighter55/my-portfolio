# Deepgram Voice Agent API key — https://console.deepgram.com
# Copy this file to `.env` and fill in a real key to run the demo.
DEEPGRAM_API_KEY=

# Optional model overrides. Defaults match the production agent exactly.
DEEPGRAM_VOICE_AGENT_STT_MODEL=nova-3-general
DEEPGRAM_VOICE_AGENT_LLM_MODEL=gpt-4o-mini
DEEPGRAM_VOICE_AGENT_TTS_MODEL=aura-asteria-en
DEEPGRAM_VOICE_AGENT_TEMPERATURE=0

# Restaurant identity used in the greeting + prompt.
RESTAURANT_NAME=Chiang Mai
